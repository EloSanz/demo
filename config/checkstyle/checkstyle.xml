<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java, properties, xml"/>

  <module name="TreeWalker">
     <!-- Simple check to verify it works -->
    <module name="AvoidStarImport"/>
    
    <!-- Forbid fully qualified names inside code (com.example.demo.*) -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="(?&lt;!package )(?&lt;!import )com\.example\.demo\.[a-zA-Z0-9_\.]+"/>
      <property name="message" value="Avoid using fully qualified class names (com.example.demo.*). Please import the class instead."/>
      <property name="ignoreComments" value="true"/>
    </module>
  </module>
</module>